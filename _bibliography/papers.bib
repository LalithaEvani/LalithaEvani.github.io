@comment{
  This file feeds the /publications/ page (rendered by jekyll-scholar).
  Replace the template entries below with your real BibTeX.
  Tip: copy entries straight from Google Scholar ("Cite" -> BibTeX) or the
  publisher / arXiv page. Useful al-folio-specific fields:
    abbr={CVPR}          short venue tag shown on the left
    selected={true}      also feature this paper on the About page
    pdf={my-paper.pdf}   file in assets/pdf/  (or a full URL)
    arxiv={2401.12345}   adds an arXiv link
    code={https://github.com/...}
    bibtex_show={true}   shows a "BibTeX" button with the raw entry
}

@article{evani2025example,
  abbr      = {arXiv},
  title     = {Your paper title goes here},
  author    = {Evani, Lalitha and Coauthor, First},
  journal   = {arXiv preprint arXiv:XXXX.XXXXX},
  year      = {2025},
  url       = {https://arxiv.org/abs/XXXX.XXXXX},
  selected  = {true},
  abstract  = {TODO: paste your abstract here. This text appears when the reader clicks "Abs".}
}

